{
  "name": "monster-coliseum-brawl",
  "version": "0.3.0",
  "description": "Monster Coliseum Brawl — a 3D multiplayer monster-battling prototype (Three.js + Electron + authoritative Node host).",
  "author": "Monster Coliseum Brawl Team",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dist": "vite build && electron-builder --publish never",
    "dist:linux": "vite build && electron-builder --linux zip --publish never",
    "dist:win": "vite build && electron-builder --win zip --publish never",
    "dist:mac": "vite build && electron-builder --mac zip --universal --publish never",
    "test": "node --test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "three": "^0.169.0",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.monstercoliseum.brawl",
    "productName": "MonsterColiseumBrawl",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "server/**/*",
      "assets/data/**/*",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MonsterColiseumBrawl-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "artifactName": "MonsterColiseumBrawl-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "artifactName": "MonsterColiseumBrawl-${version}-linux-${arch}.${ext}"
    }
  }
}
